// FICTIONAL ENGINEERING PROJECT — NOT FOR CONSTRUCTION
// NVIDIA is a non-safety quality subsystem. The PLC owns all motion,
// permissives, timeouts, restart behavior and product release decisions.
FUNCTION_BLOCK "FB_VisionInterface"
VAR_INPUT
   Enable : Bool;
   TriggerEdge : Bool;
   InspectionId : UDInt;
   SessionEpoch : UDInt;
   ExpectedModelId : String[32];
   ExpectedModelHash : String[64];
   ExpectedDatasetId : String[32];
   ExpectedCalibrationId : String[32];
   MinimumConfidence : Real;
   MaximumResultAgeMs : UDInt;
   MaximumProcessingTimeMs : UDInt;
   MaximumQueueDepth : UInt;
   Ready : Bool;
   Busy : Bool;
   CaptureAckId : UDInt;
   ProcessingState : USInt;
   ServiceHealthy : Bool;
   CameraHealthy : Bool;
   ModelLoaded : Bool;
   MaintenanceActive : Bool;
   QueueDepth : UInt;
   Result : "UDT_VisionResult";
   Heartbeat : UDInt;
   Timeout : Time;
   HeartbeatTimeout : Time;
   ResetEdge : Bool;
END_VAR
VAR_OUTPUT
   Trigger : Bool;
   RequestInProgress : Bool;
   Accepted : Bool;
   PublicationAck : Bool;
   QualityPass : Bool;
   HoldRequired : Bool;
   Fault : Bool;
   HeartbeatHealthy : Bool;
   ResultStuckHigh : Bool;
   ResultAgeMs : UDInt;
   DiagReason : "E_VisionDiag";
END_VAR
VAR
   tReady : TON;
   tResult : TON;
   tHeartbeat : TON;
   tResultClear : TON;
   pending : Bool;
   triggered : Bool;
   requestObserved : Bool;
   issuedOnce : Bool;
   heartbeatInitialized : Bool;
   resultMustClear : Bool;
   publicationWasAwaitingClear : Bool;
   heartbeatChanged : Bool;
   heartbeatRegressed : Bool;
   identityValid : Bool;
   metricsValid : Bool;
   timestampsValid : Bool;
   reasonBitsValid : Bool;
   passPayloadValid : Bool;
   negativePayloadValid : Bool;
   latchedId : UDInt;
   latchedSessionEpoch : UDInt;
   currentSessionEpoch : UDInt;
   lastIssuedId : UDInt;
   lastHeartbeat : UDInt;
END_VAR
BEGIN
   // Trigger is a level-held OPC UA request. ACCEPTED is a one-scan quality-decision pulse.
   // PublicationAck is transport ownership only and never authorizes transfer.
   #Trigger := FALSE;
   #RequestInProgress := #pending;
   #Accepted := FALSE;
   #PublicationAck := FALSE;
   #publicationWasAwaitingClear := #resultMustClear;
   IF #Result.ResultValid THEN #PublicationAck := TRUE; #resultMustClear := TRUE; END_IF;

   // Session epoch changes reset the monotonic ID space only when no transaction
   // or immutable result publication remains. Cross-session reuse fails closed.
   IF #SessionEpoch <> #currentSessionEpoch THEN
      IF #pending OR #Result.ResultValid THEN
         #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".SESSION_MISMATCH;
      ELSE
         #currentSessionEpoch := #SessionEpoch; #issuedOnce := FALSE; #lastIssuedId := UDINT#0; #resultMustClear := FALSE;
      END_IF;
   END_IF;
   IF #pending AND (#InspectionId <> #latchedId) THEN
      #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".NON_MONOTONIC_REQUEST;
   END_IF;

   // Heartbeat supervision is suppressed only while the PLC deliberately disables
   // the service. Serial wrap is accepted; regression is latched as a fault.
   IF NOT #Enable THEN
      #heartbeatInitialized := FALSE; #heartbeatChanged := FALSE; #heartbeatRegressed := FALSE; #lastHeartbeat := #Heartbeat;
   ELSIF NOT #heartbeatInitialized THEN
      #heartbeatInitialized := TRUE; #heartbeatChanged := FALSE; #heartbeatRegressed := FALSE; #lastHeartbeat := #Heartbeat;
   ELSE
      #heartbeatChanged := #Heartbeat <> #lastHeartbeat;
      IF #heartbeatChanged THEN
         IF (#Heartbeat < #lastHeartbeat) AND NOT ((#lastHeartbeat > UDINT#4294967040) AND (#Heartbeat < UDINT#256)) THEN
            #heartbeatRegressed := TRUE;
         ELSIF NOT #heartbeatRegressed THEN
            #lastHeartbeat := #Heartbeat;
         END_IF;
      END_IF;
   END_IF;
   #tHeartbeat(IN := #Enable AND #heartbeatInitialized AND NOT #heartbeatChanged, PT := #HeartbeatTimeout);
   #HeartbeatHealthy := NOT #Enable OR (NOT #tHeartbeat.Q AND NOT #heartbeatRegressed);

   // A complete result remains immutable until its exact result ID is acknowledged
   // and RESULT_VALID clears. An idle publication is never interpreted as PASS.
   #tResultClear(IN := #resultMustClear AND #Result.ResultValid, PT := #Timeout);
   IF #resultMustClear AND NOT #Result.ResultValid THEN #resultMustClear := FALSE; END_IF;
   IF #Enable AND #Result.ResultValid AND NOT #pending AND NOT #publicationWasAwaitingClear THEN
      #ResultStuckHigh := TRUE; #Fault := TRUE; #HoldRequired := TRUE;
      IF #DiagReason = "E_VisionDiag".VISION_OK THEN #DiagReason := "E_VisionDiag".RESULT_STUCK_VALID; END_IF;
   END_IF;

   // Edge state is diagnostic input only. Contradictory live states fail closed.
   IF #Enable AND ((#Busy AND NOT #Ready) OR (#Busy AND #Result.ResultValid)
      OR (#Ready AND NOT #ServiceHealthy) OR (#Ready AND NOT #CameraHealthy)
      OR (#Ready AND NOT #ModelLoaded) OR (#MaintenanceActive AND (#Busy OR #Result.ResultValid)))
      AND NOT #Fault THEN
      #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".INTERFACE_CONTRADICTION;
   END_IF;

   IF #TriggerEdge AND #Enable AND NOT #Result.ResultValid AND NOT #pending AND NOT #Fault AND NOT #HoldRequired AND NOT #resultMustClear THEN
      IF #SessionEpoch = UDINT#0 THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".SESSION_MISMATCH;
      ELSIF (#InspectionId = UDINT#0) OR (#issuedOnce AND ((#lastIssuedId = UDINT#4294967295) OR (#InspectionId <= #lastIssuedId))) THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".NON_MONOTONIC_REQUEST;
      ELSE
         #pending := TRUE; #triggered := FALSE; #requestObserved := FALSE; #latchedId := #InspectionId; #latchedSessionEpoch := #SessionEpoch; #lastIssuedId := #InspectionId; #issuedOnce := TRUE; #QualityPass := FALSE; #ResultAgeMs := UDINT#0;
      END_IF;
   END_IF;

   #tReady(IN := #pending AND NOT #triggered AND (NOT #Ready OR #Busy), PT := #Timeout);
   IF #pending AND NOT #triggered AND #Ready AND NOT #Busy AND NOT #Fault THEN #triggered := TRUE; END_IF;
   IF #pending AND #triggered AND #Ready AND #Busy AND (#CaptureAckId <> #latchedId) THEN
      #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".CAPTURE_ACK_MISMATCH;
   ELSIF #pending AND #triggered AND #Ready AND #Busy AND NOT ((#ProcessingState = USINT#2) OR (#ProcessingState = USINT#3)) THEN
      #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".PROCESSING_STATE_INVALID;
   END_IF;
   IF #pending AND #triggered AND #Ready AND #Busy THEN #requestObserved := TRUE; END_IF;
   #Trigger := #pending AND #triggered AND NOT #requestObserved AND NOT #Result.ResultValid AND NOT #Fault;
   #tResult(IN := #pending AND #triggered, PT := #Timeout);
   IF #pending AND #triggered THEN #ResultAgeMs := TIME_TO_UDINT(#tResult.ET); END_IF;

   IF #pending AND #triggered AND #Result.ResultValid AND NOT #Fault THEN
      #PublicationAck := TRUE; #resultMustClear := TRUE;
      #identityValid := (#Result.ModelId = #ExpectedModelId) AND (#Result.ModelHash = #ExpectedModelHash)
         AND (#Result.DatasetId = #ExpectedDatasetId) AND (#Result.CalibrationId = #ExpectedCalibrationId);
      #timestampsValid := (#Result.CaptureTimestampUtcMs > ULINT#0)
         AND (#Result.CaptureTimestampUtcMs <= #Result.InferenceTimestampUtcMs)
         AND (#Result.InferenceTimestampUtcMs <= #Result.PublicationTimestampUtcMs);
      #metricsValid := (#Result.Confidence >= 0.0) AND (#Result.Confidence <= 1.0)
         AND (#ResultAgeMs <= #MaximumResultAgeMs)
         AND (#Result.ProcessingTimeMs <= #MaximumProcessingTimeMs)
         AND (#Result.InferenceTimeMs = #Result.ProcessingTimeMs)
         AND (#QueueDepth <= #MaximumQueueDepth);
      #reasonBitsValid := (#Result.ReasonBits AND DWORD#16#FFFF0000) = DWORD#0;
      #passPayloadValid := (#Result.Disposition = USINT#1)
         AND (#Result.ReasonBits = DWORD#0) AND (#Result.Confidence >= #MinimumConfidence)
         AND #Result.Bottle1Pass AND #Result.Bottle2Pass
         AND (#Result.Fill1Status = USINT#2) AND (#Result.Fill2Status = USINT#2)
         AND NOT #Result.LeakOrSpill AND NOT #Result.LowConfidence
         AND NOT #Result.Warning AND NOT #Result.Fault;
      #negativePayloadValid := ((#Result.Disposition = USINT#2)
         OR (#Result.Disposition = USINT#3))
         AND (#Result.ReasonBits <> DWORD#0);

      IF #Result.SessionEpoch <> #latchedSessionEpoch THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".SESSION_MISMATCH;
      ELSIF #Result.ResultId <> #latchedId THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".RESULT_ID_MISMATCH;
      ELSIF #CaptureAckId <> #latchedId THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".CAPTURE_ACK_MISMATCH;
      ELSIF #ProcessingState <> USINT#4 THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".PROCESSING_STATE_INVALID;
      ELSIF (#ExpectedModelId = '') OR (#ExpectedModelHash = '') OR (#Result.ModelId <> #ExpectedModelId) OR (#Result.ModelHash <> #ExpectedModelHash) THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".MODEL_MISMATCH;
      ELSIF (#ExpectedDatasetId = '') OR (#Result.DatasetId <> #ExpectedDatasetId) THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".DATASET_MISMATCH;
      ELSIF (#ExpectedCalibrationId = '') OR (#Result.CalibrationId <> #ExpectedCalibrationId) THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".CALIBRATION_MISMATCH;
      ELSIF NOT #identityValid THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".MODEL_MISMATCH;
      ELSIF NOT #ServiceHealthy THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".SERVICE_UNHEALTHY;
      ELSIF NOT #CameraHealthy THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".CAMERA_UNHEALTHY;
      ELSIF NOT #ModelLoaded THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".MODEL_NOT_LOADED;
      ELSIF #MaintenanceActive THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".MAINTENANCE_ACTIVE;
      ELSIF #QueueDepth > #MaximumQueueDepth THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".QUEUE_SATURATED;
      ELSIF NOT #timestampsValid THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".TIMESTAMP_INVALID;
      ELSIF NOT #metricsValid THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".RESULT_METRICS_INVALID;
      ELSIF NOT #reasonBitsValid THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".REASON_CODE_INVALID;
      ELSIF #passPayloadValid THEN
         #Accepted := TRUE; #QualityPass := TRUE; #HoldRequired := FALSE; #DiagReason := "E_VisionDiag".VISION_OK;
      ELSIF #negativePayloadValid THEN
         #Accepted := TRUE; #QualityPass := FALSE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".QUALITY_BLOCK;
      ELSIF (#Result.Disposition = USINT#4) AND (#Result.ReasonBits <> DWORD#0) THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".SERVICE_UNHEALTHY;
      ELSIF #Result.ReasonBits = DWORD#0 THEN
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".REASON_CODE_INVALID;
      ELSE
         #Fault := TRUE; #HoldRequired := TRUE; #DiagReason := "E_VisionDiag".DISPOSITION_CONTRADICTION;
      END_IF;
      #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE;
   END_IF;

   // First-out cause remains latched until a cause-cleared, non-transaction reset.
   IF NOT #Fault THEN
      IF #tReady.Q AND #pending AND NOT #triggered THEN #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".READY_TIMEOUT;
      ELSIF #tResult.Q AND #pending AND #triggered AND NOT #Result.ResultValid THEN #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #resultMustClear := TRUE; #DiagReason := "E_VisionDiag".RESULT_TIMEOUT;
      ELSIF NOT #HeartbeatHealthy THEN #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE; #DiagReason := "E_VisionDiag".HEARTBEAT_LOSS;
      ELSIF #tResultClear.Q THEN #ResultStuckHigh := TRUE; #Fault := TRUE; #HoldRequired := TRUE; IF #DiagReason = "E_VisionDiag".VISION_OK THEN #DiagReason := "E_VisionDiag".RESULT_STUCK_VALID; END_IF;
      END_IF;
   END_IF;
   IF NOT #Enable AND #pending THEN
      IF NOT #Fault THEN #DiagReason := "E_VisionDiag".INTERFACE_CONTRADICTION; END_IF;
      #Fault := TRUE; #HoldRequired := TRUE; #pending := FALSE; #triggered := FALSE; #requestObserved := FALSE;
   END_IF;
   IF #Fault THEN #Trigger := FALSE; #triggered := FALSE; #requestObserved := FALSE; END_IF;

   IF #ResetEdge AND NOT #pending AND NOT #Busy AND NOT #Result.ResultValid AND NOT #TriggerEdge
      AND ((#Enable AND #Ready AND #ServiceHealthy AND #CameraHealthy AND #ModelLoaded
         AND NOT #MaintenanceActive AND #HeartbeatHealthy) OR NOT #Enable) THEN
      #Fault := FALSE; #QualityPass := FALSE; #HoldRequired := FALSE; #ResultStuckHigh := FALSE; #resultMustClear := FALSE; #requestObserved := FALSE; #heartbeatRegressed := FALSE; #DiagReason := "E_VisionDiag".VISION_OK;
   END_IF;
   #RequestInProgress := #pending;
END_FUNCTION_BLOCK
