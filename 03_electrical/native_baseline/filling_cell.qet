    <diagram displaycols="true" author="Principal electrical engineer - concept" freezeNewElement="false" locmach="FC01" version="0.100.1-dev" filename="filling_cell.qet" displayAt="bottom" displayrows="true" title="Design basis, legends, reference designations" order="3" auto_page_num="" rows="6" date="null" height="500" indexrev="A" plant="Compact filling cell" folio="%id/%total" cols="15" rowsize="80" colsize="50" freezeNewConductor="false">
        <defaultconductor function="" bicolor="false" cable="" color2="#000000" num="_" text_color="#000000" onetextperfolio="0" bus="" conductor_color="" vertirotatetext="0" condsize="1" formula="" dash-size="1" numsize="9" vertical-alignment="AlignRight" displaytext="1" tension_protocol="" horizontal-alignment="AlignBottom" type="multi" conductor_section="" horizrotatetext="0"/>
        <inputs>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:11pt; font-weight:600; color:#17365d;&quot;>E-03  DESIGN BASIS, LEGENDS, REFERENCE DESIGNATIONS&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="32" x="40" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:7pt; font-weight:600; color:#b91c1c;&quot;>FICTIONAL CONCEPT DESIGN - NOT FOR CONSTRUCTION&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="455" x="40" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:4pt; font-weight:600; color:#b91c1c;&quot;>CONCEPTUAL SAFETY ARCHITECTURE - REQUIRES REVIEW, RISK ASSESSMENT,&lt;br />VERIFICATION AND VALIDATION BY A QUALIFIED MACHINERY-SAFETY ENGINEER.&lt;br />NO PERFORMANCE LEVEL, SIL, CATEGORY OR REGULATORY COMPLIANCE IS CLAIMED.&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="468" x="40" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:8pt; font-weight:600; color:#000000;&quot;>REFERENCE DESIGNATION: =FC01+LOCATION-TAG | CP01 panel | FD01 field | OP01 operator | IF01 capping&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="80" x="55" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:8pt; color:#000000;&quot;>SUPPLY BASIS: 400/230 VAC, 3P+N+PE, 50 Hz, TN-S assumed. CONTROL: 24 VDC PELV.&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="120" x="55" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:7pt; color:#000000;&quot;>PNP ordinary sensors. Analog: isolated 4-20 mA; provisional raw 5530-27648. Field devices terminate at identified X strips.&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="160" x="55" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:8pt; font-weight:600; color:#b45309;&quot;>PROTECTION, CONDUCTOR SIZING, VOLTAGE DROP, FAULT WITHSTAND AND THERMAL RESULTS ARE PRELIMINARY.&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="205" x="55" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;>&#xa;&lt;html>&lt;head>&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; />&lt;style type=&quot;text/css&quot;>&#xa;p, li { white-space: pre-wrap; }&#xa;&lt;/style>&lt;/head>&lt;body style=&quot; font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;>&#xa;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;>&lt;span style=&quot; font-family:'Sans Serif'; font-size:7pt; color:#000000;&quot;>Wire IDs are unique physical segments. Cable/core and terminal references appear beside signal blocks; schedules are authoritative.&lt;/span>&lt;/p>&lt;/body>&lt;/html>" y="255" x="55" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular"/>
