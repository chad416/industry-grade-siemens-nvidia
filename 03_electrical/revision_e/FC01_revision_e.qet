            <input rotation="0" text="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;p, li { white-space: pre-wrap; }&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot;font-family:'Liberation Sans'; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;&lt;p style=&quot;margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot;font-family:'Liberation Sans'; font-size:4.6pt; font-weight:600; color:#7c2d12;&quot;&gt;OPEN: supply/fault current, motor and pump data, cable routes, conductor sizing, thermal/EMC study, exact PC200 envelope and construction review.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;" y="427" x="45" font="Liberation Sans,9,-1,0,50,0,0,0,0,0,Regular" />
